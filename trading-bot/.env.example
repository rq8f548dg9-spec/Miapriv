# Copiare in .env e compilare. Il file .env NON va versionato (cfr. .gitignore).
# Nessuna chiave deve comparire nel codice o nei log.

# --- TESTNET (https://testnet.binance.vision) -------------------------------
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- LIVE: denaro reale -----------------------------------------------------
# Nomi deliberatamente diversi da quelli testnet: cosi' una configurazione
# sbagliata produce un errore di avvio, non un ordine reale per distrazione.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Autorizzazione esplicita al denaro reale. Serve solo con mode: live.
# Valore accettato: esattamente "yes". Lasciare vuoto o rimuovere in testnet.
# I_UNDERSTAND_LIVE_TRADING_RISK=
