# ---- L'unica cosa obbligatoria ---------------------------------------------
# La chiave segreta che sta dentro il tuo link. Generala cosi':
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Il tuo indirizzo diventera':  https://.../?k=QUESTA-CHIAVE
ACCESS_KEY=

# ---- Facoltative ------------------------------------------------------------
# Contenuto di un cookies.txt esportato da instagram.com mentre sei loggato.
# Serve per i contenuti che Instagram non mostra agli sconosciuti.
# Incollalo tutto qui dentro (va bene su piu' righe).
IG_COOKIES=

# Oppure, se i cookie li tieni in un file su disco:
COOKIES_FILE=

# Limite per singolo file, in MB. 0 = nessun limite.
MAX_FILESIZE_MB=2048

# Quante ricerche in parallelo (tenere basso).
MAX_CONCURRENT=2

# Metti 1 solo se vuoi un sito davvero aperto a chiunque, senza chiave.
OPEN_MODE=
