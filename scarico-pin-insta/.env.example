# ---- Obbligatorio ----------------------------------------------------------
# Password per entrare nel sito. Mettila lunga: e' l'unica cosa che protegge
# il tuo server. Senza questa variabile il server si rifiuta di partire.
APP_PASSWORD=cambia-questa-password-con-una-lunga

# Chiave usata per firmare i token di sessione. Generala una volta con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Se la lasci vuota il server ne crea una nuova a ogni riavvio e tutte le
# sessioni (e le scorciatoie iOS) vanno rifatte.
SECRET_KEY=

# ---- Opzionali -------------------------------------------------------------
# Indirizzo e porta di ascolto.
HOST=0.0.0.0
PORT=8080

# Cookie esportati dal browser in formato Netscape (cookies.txt).
# Servono quasi sempre per Instagram, quasi mai per Pinterest.
# NON committare questo file: e' gia' in .gitignore.
COOKIES_FILE=

# Giorni di validita' della sessione sul telefono.
SESSION_DAYS=60

# Limite di dimensione per singolo video, in MB. 0 = nessun limite.
MAX_FILESIZE_MB=2048

# Quante estrazioni in parallelo (tenere basso: 1-3).
MAX_CONCURRENT=2
